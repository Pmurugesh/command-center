{
  "compilerOptions": {
    "lib": ["esnext"],
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": { "@/*": ["../src/*"] }
  },
  "include": ["**/*.ts"]
}
